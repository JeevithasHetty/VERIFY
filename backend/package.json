{
  "name": "fieldverify-backend",
  "version": "1.0.0",
  "description": "FieldVerify - Intelligent Vehicle Evidence Verification backend",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "node src/workers/imageWorker.js",
    "worker:dev": "node --watch src/workers/imageWorker.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "bullmq": "^5.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exifr": "^7.1.3",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "mongodb": "^6.20.0",
    "mongoose": "^8.5.3",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.0.7",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "sharp": "^0.33.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "pino-pretty": "^11.2.2",
    "supertest": "^7.0.0"
  }
}
