# ---------------------------------------------------------------------------
# FIELDVERIFY BACKEND - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=4000
API_BASE_PATH=/api/v1

# MongoDB
MONGODB_URI=mongodb://localhost:27017/fieldverify

# Redis / BullMQ
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Storage
# Options: local | mongodb
# local = local development; mongodb = MongoDB GridFS for Render deployment
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=uploads

# Upload constraints
MAX_UPLOAD_SIZE_MB=10
MAX_BATCH_SIZE=10
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Queue
QUEUE_NAME=image-processing
JOB_ATTEMPTS=3
JOB_BACKOFF_MS=2000

# Image quality thresholds (configurable, not hardcoded in logic)
BLUR_VARIANCE_THRESHOLD=55
LOW_LIGHT_BRIGHTNESS_THRESHOLD=45
OVEREXPOSED_BRIGHTNESS_THRESHOLD=225
LOW_CONTRAST_THRESHOLD=25
MIN_WIDTH=480
MIN_HEIGHT=360
UNUSUAL_ASPECT_RATIO_MIN=0.4
UNUSUAL_ASPECT_RATIO_MAX=2.6

# Duplicate detection
NEAR_DUPLICATE_HAMMING_THRESHOLD=10

# Plate validation
PLATE_REGEX=^[A-Z]{2}[0-9]{1,2}[A-Z]{1,3}[0-9]{1,4}$

# Scoring / recommendation thresholds
ACCEPT_THRESHOLD=85
REVIEW_THRESHOLD=60

# Optional AI review (NOT required for core pipeline to function)
AI_REVIEW_ENABLED=false
AI_REVIEW_TRIGGER_SCORE=80
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=
AI_PROVIDER_MODEL=

# Logging
LOG_LEVEL=info

# Production demo mode: Render can run the BullMQ worker in the same web process.
RUN_WORKER_IN_API=false
